{
  "name": "blackcatacademy/blackcat-sessions",
  "description": "DB-backed sessions module for the BlackCat ecosystem.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-pdo": "*",
    "psr/log": "^3.0",
    "psr/simple-cache": "^1.0 || ^2.0 || ^3.0",
    "blackcatacademy/blackcat-core": "dev-dev",
    "blackcatacademy/blackcat-database": "dev-dev"
  },
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/blackcatacademy/blackcat-core"
    },
    {
      "type": "git",
      "url": "https://github.com/blackcatacademy/blackcat-config"
    },
    {
      "type": "git",
      "url": "https://github.com/blackcatacademy/blackcat-database"
    },
    {
      "type": "git",
      "url": "https://github.com/blackcatacademy/blackcat-database-crypto"
    },
    {
      "type": "git",
      "url": "https://github.com/blackcatacademy/blackcat-crypto"
    }
  ],
  "autoload": {
    "psr-4": {
      "BlackCat\\Sessions\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BlackCat\\Sessions\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.11"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
